<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ride_card" android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="8dp" android:background="@drawable/ramo_ride_card_background">
    <TextView android:id="@+id/ride_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#101114" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/ride_destination" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#353942" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
