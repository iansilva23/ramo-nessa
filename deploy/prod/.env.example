# Ramo Nessa — produção
# Use generate-env.mjs para criar deploy/prod/.env com segredos internos aleatórios.

APP_DOMAIN=app.example.invalid
ACME_EMAIL=ops@example.invalid

POSTGRES_USER=ramonessa
POSTGRES_DB=ramonessa
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql://ramonessa:REPLACE_WITH_RANDOM_SECRET@postgres:5432/ramonessa
DB_POOL_MAX=20
DB_SSL=false
DB_SSL_CA=

SHUTDOWN_TIMEOUT_MS=10000

OTP_HASH_SECRET=REPLACE_WITH_64_HEX_CHARS
OTP_RATE_LIMIT_SECRET=REPLACE_WITH_64_HEX_CHARS
OTP_WEBHOOK_URL=https://otp.example.invalid/send
OTP_WEBHOOK_TOKEN=REPLACE_WITH_PROVIDER_TOKEN

ADMIN_MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
ADMIN_LOGIN_RATE_LIMIT_SECRET=REPLACE_WITH_64_HEX_CHARS
# Preencha depois de criar o primeiro usuário Admin. Enquanto vazio,
# comandos de repasse protegidos ficam bloqueados.
ADMIN_PAYOUT_APPROVER_USER_ID=

ROUTING_TIMEOUT_MS=5000
GOOGLE_MAPS_SERVER_API_KEY=REPLACE_WITH_SERVER_KEY
PLACE_PROOF_SECRET=REPLACE_WITH_64_HEX_CHARS
PLACE_PROOF_TTL_SECONDS=1800

PUSH_PROVIDER=fcm
FIREBASE_SERVICE_ACCOUNT_HOST_FILE=./secrets/firebase-service-account.json

DOCUMENT_INSPECTION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTES_BASE64
DOCUMENT_INSPECTION_TTL_SECONDS=60

MERCADO_PAGO_ACCESS_TOKEN=REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

DRIVER_PAYOUT_PROVIDER_NAME=
DRIVER_PAYOUT_PROVIDER_URL=
DRIVER_PAYOUT_PROVIDER_TOKEN=
DRIVER_PAYOUT_RECONCILE_INTERVAL_SECONDS=60
