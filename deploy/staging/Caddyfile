{
  admin off
  email {$ACME_EMAIL}
}

:8080 {
  respond /healthz 200
  respond 404
}

{$APP_DOMAIN} {
  encode zstd gzip
  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    X-Robots-Tag "noindex, nofollow, noarchive"
  }

  @api path /v1/* /health /ready
  handle @api {
    reverse_proxy core:8080 {
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }

  redir / /admin/ 302
  redir /admin /admin/ 308


  # Web apps usam a mesma origem HTTPS de /v1, sem CORS nem novo backend.
  # Bundles estáticos devem ser homologados e montados em /srv/web.
  redir /passageiro /passageiro/ 308
  redir /motorista /motorista/ 308

  handle_path /passageiro/* {
    root * /srv/web/passenger
    # Apenas este escopo necessita de GPS. O ADM mantém geolocation=().
    header Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    header Cache-Control "no-store"
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://*.gstatic.com; connect-src 'self' wss://{$APP_DOMAIN} https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    try_files {path} /index.html
    file_server
  }

  handle_path /motorista/* {
    root * /srv/web/driver
    header Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    header Cache-Control "no-store"
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://maps.googleapis.com https://maps.gstatic.com https://*.gstatic.com; connect-src 'self' wss://{$APP_DOMAIN} https://maps.googleapis.com https://maps.gstatic.com https://*.googleapis.com https://*.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    try_files {path} /index.html
    file_server
  }


  handle_path /admin/* {
    root * /srv/admin
    header Cache-Control "no-store"
    header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    try_files {path} /index.html
    file_server
  }

  handle {
    respond "Not Found" 404
  }
}
