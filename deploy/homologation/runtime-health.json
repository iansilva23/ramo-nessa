{
  "services": {
    "google-maps-mock": {
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:8091/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"],
        "interval": "5s", "timeout": "3s", "retries": 10, "start_period": "5s"
      }
    },
    "document-storage": {
      "healthcheck": {
        "test": ["CMD", "node", "-e", "fetch('http://127.0.0.1:8090/').then(r=>{if(r.status!==401)process.exit(1)}).catch(()=>process.exit(1))"],
        "interval": "5s", "timeout": "3s", "retries": 10, "start_period": "5s"
      }
    }
  }
}
