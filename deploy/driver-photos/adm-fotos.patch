diff --git a/styles.css b/styles.css
index 5ad55e9..fbfbe59 100644
--- a/styles.css
+++ b/styles.css
@@ -1813,6 +1813,210 @@ td strong {
   gap: 12px;
 }
 
+.driver-photo-workspace {
+  display: grid;
+  gap: 16px;
+  min-width: 0;
+}
+
+.driver-photo-dossier {
+  margin: 20px 0;
+  padding-top: 16px;
+  border-top: 1px solid var(--border);
+}
+
+.driver-photo-dossier[hidden] {
+  display: none;
+}
+
+.driver-photo-dossier > h3 {
+  margin: 0;
+}
+
+.driver-photo-dossier > p {
+  margin: 6px 0 14px;
+}
+
+.driver-photo-actions {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+}
+
+.driver-photo-workspace [hidden] {
+  display: none;
+}
+
+.driver-photo-layout {
+  display: grid;
+  grid-template-columns: minmax(230px, 0.77fr) minmax(0, 1.4fr);
+  align-items: start;
+  gap: 16px;
+}
+
+.driver-photo-queue,
+.driver-photo-preview,
+.driver-photo-settings {
+  min-width: 0;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--raised);
+}
+
+.driver-photo-queue:has(.driver-photo-groups:empty) {
+  display: none;
+}
+
+.driver-photo-layout:has(.driver-photo-groups:empty) {
+  grid-template-columns: minmax(0, 1fr);
+}
+
+.driver-photo-groups {
+  max-height: 530px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+}
+
+.driver-photo-group {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 12px;
+}
+
+.driver-photo-group + .driver-photo-group {
+  border-top: 1px solid var(--border);
+}
+
+.driver-photo-group__identity {
+  padding: 2px 7px 9px;
+}
+
+.driver-photo-group__identity h3,
+.driver-photo-preview__header h3 {
+  margin: 0;
+  font-size: 15px;
+  overflow-wrap: anywhere;
+}
+
+.driver-photo-group__identity p,
+.driver-photo-preview__header p,
+.driver-photo-settings__body p {
+  margin: 4px 0 0;
+}
+
+.driver-photo-preview {
+  padding: 16px;
+}
+
+.driver-photo-preview__header {
+  margin-bottom: 12px;
+}
+
+.driver-photo-stage {
+  display: grid;
+  place-items: center;
+  grid-template-columns: minmax(0, 1fr);
+  min-height: 180px;
+  max-height: min(52dvh, 490px);
+  overflow: auto;
+  border-radius: 9px;
+  background: var(--ink);
+  color: var(--surface);
+  text-align: center;
+}
+
+.driver-photo-stage img {
+  display: block;
+  width: 100%;
+  max-height: min(52dvh, 490px);
+  object-fit: contain;
+}
+
+.driver-photo-stage--zoomed {
+  display: block;
+}
+
+.driver-photo-stage--zoomed img {
+  width: auto;
+  max-width: none;
+  max-height: none;
+}
+
+.driver-photo-preview__tools {
+  padding-top: 10px;
+}
+
+.driver-photo-decision {
+  margin-top: 12px;
+  padding-top: 12px;
+  border-top: 1px solid var(--border);
+}
+
+.driver-photo-decision .driver-photo-actions {
+  justify-content: flex-end;
+}
+
+.driver-photo-correction textarea {
+  width: 100%;
+  min-height: 72px;
+  resize: vertical;
+}
+
+.driver-photo-correction button + button {
+  margin-left: 8px;
+}
+
+.driver-photo-settings summary {
+  padding: 12px 16px;
+  color: var(--ink-soft);
+  font-size: 13px;
+  font-weight: 650;
+  cursor: pointer;
+}
+
+.driver-photo-settings__body {
+  padding: 0 16px 14px;
+}
+
+.driver-photo-settings__body label {
+  display: inline-flex;
+  align-items: flex-start;
+  gap: 7px;
+}
+
+.driver-photo-placeholder,
+.driver-photo-feedback {
