# Core
PORT=8080
NODE_ENV=development
SHUTDOWN_TIMEOUT_MS=10000

# PostgreSQL
DATABASE_URL=postgresql://ramonessa:ramonessa@localhost:5432/ramonessa
DB_POOL_MAX=10
DB_SSL=false

# Somente desenvolvimento. Nunca habilitar identidade dev em produção.
ALLOW_DEV_IDENTITY=true
ALLOW_DEV_PAYMENT_GATEWAY=true

# Google Maps Platform: os apps falam somente com o Core para Routes/Places.
# Nunca reutilize a chave de servidor nos apps móveis.
ROUTING_PROVIDER=google
ROUTING_TIMEOUT_MS=5000
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com/
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1/
# Assina a validação de destinos externos retornada pelo Core.
# Produção exige segredo aleatório com pelo menos 32 caracteres.
PLACE_PROOF_SECRET=
PLACE_PROOF_TTL_SECONDS=1800


# OTP / autenticação por telefone
# Desenvolvimento local: ALLOW_DEV_OTP=true expõe o código somente na resposta dev.
# Produção: OTP_PROVIDER=webhook é obrigatório e o endpoint deve ser HTTPS.
ALLOW_DEV_OTP=true
OTP_PROVIDER=dev
OTP_HASH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
OTP_RATE_LIMIT_SECRET=troque-por-outro-segredo-com-pelo-menos-32-caracteres
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# Só habilite atrás de proxy confiável que sobrescreva X-Forwarded-For.
TRUST_PROXY=false

# Produção deve manter:
# ALLOW_DEV_IDENTITY=false
# ALLOW_DEV_OTP=false
# ALLOW_DEV_PAYMENT_GATEWAY=false

# Admin humano / painel web
# Em produção, gere uma chave aleatória de 32 bytes e codifique em base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_LOGIN_RATE_LIMIT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Em produção, configure com o userId do proprietário autorizado a comandar
# repasses. Vazio = aprovações e comandos de Pix protegidos bloqueados.
ADMIN_PAYOUT_APPROVER_USER_ID=


# Push
# disabled: sem entrega externa.
# webhook: mantém compatibilidade com o adaptador HTTP existente.
# fcm: Firebase Cloud Messaging HTTP v1 direto pelo Core.
PUSH_PROVIDER=disabled
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# Para FCM use UMA das opções abaixo. Nunca versione a credencial real.
# Em deploy/CI, prefira FIREBASE_SERVICE_ACCOUNT_JSON vindo de Secret.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Alternativa para VPS: caminho absoluto de arquivo privado fora do repositório.
FIREBASE_SERVICE_ACCOUNT_FILE=


# Documentos privados do motorista (CNH/CRLV)
# Escolha apenas UMA forma de storage:
# 1) VPS/servidor único: diretório absoluto privado e persistente.
DOCUMENT_STORAGE_LOCAL_DIR=
# 2) Storage HTTP privado: deve aceitar GET e PUT autenticados por Bearer.
DOCUMENT_STORAGE_BASE_URL=
DOCUMENT_STORAGE_AUTH_TOKEN=
DOCUMENT_STORAGE_TIMEOUT_MS=5000
# Necessária quando qualquer storage documental estiver habilitado.
# Gere 32 bytes aleatórios em base64.
DOCUMENT_INSPECTION_ENCRYPTION_KEY=
DOCUMENT_INSPECTION_TTL_SECONDS=60

# Mercado Pago / Checkout Transparente via Orders API
# Desenvolvimento/testes usa o Access Token de teste.
MERCADO_PAGO_MODE=test
MERCADO_PAGO_ACCESS_TOKEN_TEST=
# Produção: só preencher no ambiente de produção.
MERCADO_PAGO_ACCESS_TOKEN=
# Gerado em Suas integrações -> Webhooks -> Configurar notificação.
MERCADO_PAGO_WEBHOOK_SECRET=

# Repasse Pix do saldo do motorista
# Preferido: Mercado Pago Payouts.
# Ative somente depois de habilitar o produto Payouts na aplicação.
DRIVER_PAYOUT_PROVIDER_NAME=
# Use "mercado-pago-payouts" para o provedor nativo abaixo.
MERCADO_PAGO_PAYOUT_MODE=test
MERCADO_PAGO_PAYOUT_ACCESS_TOKEN_TEST=
MERCADO_PAGO_PAYOUT_ACCESS_TOKEN=
# Produção: chave privada Ed25519 PEM codificada integralmente em base64.
MERCADO_PAGO_PAYOUT_PRIVATE_KEY_BASE64=
# Compatibilidade com um gateway HTTP genérico, se necessário no futuro.
DRIVER_PAYOUT_PROVIDER_URL=
DRIVER_PAYOUT_PROVIDER_TOKEN=
# Reconciliação automática: 15..3600 segundos.
DRIVER_PAYOUT_RECONCILE_INTERVAL_SECONDS=60
