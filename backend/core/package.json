{
  "name": "@ramo-nessa/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "auth:provision-driver": "tsx scripts/provision-driver-auth.ts",
    "auth:set-driver-status": "tsx scripts/set-driver-auth-status.ts",
    "admin:create-key": "tsx scripts/create-admin-api-key.ts",
    "admin:revoke-key": "tsx scripts/revoke-admin-api-key.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/server.js",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "admin:create-user": "tsx scripts/create-admin-user.ts",
    "admin:create-user:prod": "node dist/scripts/create-admin-user.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "ws": "^8.18.3"
  }
}
